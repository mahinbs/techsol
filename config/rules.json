{
  "demo": {
    "seedOnFirstRun": true,
    "note": "Sample data for client demonstrations. Set seedOnFirstRun to false for a live installation; it only ever fires on a database with no enquiries in it."
  },
  "extraction": {
    "confidenceThreshold": 0.85,
    "duplicateWindowDays": 30
  },
  "matching": {
    "exactThreshold": 0.95,
    "fuzzyThreshold": 0.72,
    "ambiguousGap": 0.06
  },
  "pricing": {
    "upliftOverLastQuotePct": 3.0,
    "fallback": "list_price"
  },
  "alerts": {
    "email": "",
    "minIntervalMinutes": 10,
    "note": "Failure alerts (Zoho write / email send / WMS) are emailed here. Blank = send to the SMTP 'from' address the app already uses. minIntervalMinutes rate-limits repeated alerts of the same kind."
  },
  "crmStages": {
    "enabled": true,
    "historyField": "",
    "map": {
      "enquiry": "Enquiry",
      "proposal_created": "Proposal Created",
      "quotation_sent": "Quotation Sent",
      "order_received": "Closed Won"
    },
    "order": [
      "Enquiry", "Proposal Created", "Partially Quotation Sent", "Quotation Sent",
      "Budgetary Quote", "Negotiation", "Positive Negotiation", "Expected Order",
      "Converted to Tender", "Closed Won"
    ],
    "note": "Auto-advance the Zoho CRM Deal Stage as each step completes. 'map' pairs an app milestone with your CRM stage picklist value (edit to match exactly). 'order' is the forward-only progression guard — the stage never moves backwards. Zoho's built-in Stage History records every change automatically on stage update; set 'historyField' to a custom Deal field's API name ONLY if you also want the log appended into that custom field."
  },
  "gst": {
    "reconTolerance": { "value": 1.0, "taxPct": 0.5 }
  },
  "tds": {
    "sections": [
      { "section": "194C", "nature": "contractor", "rateIndividual": 1.0, "rateOther": 2.0, "thresholdSingle": 30000, "thresholdAnnual": 100000, "newActRef": "393(1)-No.6" },
      { "section": "194J", "nature": "professional", "rateIndividual": 10.0, "rateOther": 10.0, "thresholdSingle": 30000, "thresholdAnnual": 30000, "newActRef": "393(1)-No.6(iii)" },
      { "section": "194I", "nature": "rent", "rateIndividual": 10.0, "rateOther": 10.0, "thresholdSingle": 240000, "thresholdAnnual": 240000, "newActRef": "393(1)-No.2(ii)" },
      { "section": "194H", "nature": "commission", "rateIndividual": 2.0, "rateOther": 2.0, "thresholdSingle": 15000, "thresholdAnnual": 15000, "newActRef": "393(1)-No.1(ii)" },
      { "section": "194Q", "nature": "purchase_goods", "rateIndividual": 0.1, "rateOther": 0.1, "thresholdSingle": 5000000, "thresholdAnnual": 5000000, "newActRef": "393(1)-No.8(ii)" }
    ],
    "missingPanRate": 20.0
  },
  "approvals": {
    "wf1_ack": ["commercial"],
    "wf2_quotation": ["commercial"],
    "wf2_vendor_po": ["commercial"],
    "wf4_bill": ["finance"]
  }
}
